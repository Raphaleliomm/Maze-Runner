# Public Supabase project URL and publishable (or legacy anon) key. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# A dark raster tile service you are licensed to use, with {z}, {x}, and {y} placeholders.
# Obtain a CARTO Basemaps API key before using this example.
NEXT_PUBLIC_TILE_URL=https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}.png?key=YOUR_CARTO_KEY
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors © CARTO
